{{ 'product-inventory.css' | asset_url | stylesheet_tag }}
<script src="{{ 'jquery.min.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'moment.js' | asset_url }}" defer="defer"></script>
<script src="{{ 'product-inventory.js' | asset_url }}" defer="defer"></script>

{% assign current_variant = product.selected_or_first_available_variant %}
<product-inventory class="product-info__block product-info__block--sm product-inventory block no-js-hidden" {{ block.shopify_attributes }}
     data-show-count="{{ settings.inventory_show_count }}"
     data-show-notice="{{ settings.inventory_show_notice }}"
     data-threshold-low="{{ settings.inventory_threshold_low }}"
     data-threshold-very-low="{{ settings.inventory_threshold_very_low }}"
     data-text-very-low="{{ block.settings.text_very_low | escape }}"
     data-text-low="{{ block.settings.text_low | escape }}"
     data-text-normal="{{ block.settings.text_normal | escape }}"
     data-text-no-stock="{{ block.settings.text_no_stock | escape }}"
     data-inventory-level=""
     data-variant-available="{{ current_variant.available }}"
     data-inventory-quantity="{{ current_variant.inventory_quantity | at_least: 0 }}"
     data-scale="35">
  {% if product and product != empty %}
    <div class="essential-upsell-product-addon-block"></div>    
    <div class="essential-upsell-product-addon-default-placement"></div>
    <div class="essential-upsell-default-placement"></div>
    <div class="main_product-inventory">
      <div class="product-inventory__text relative">
        <span class="product-inventory__status js-inventory-notice"></span>
        {% if block.settings.show_urgency_message %}
          <span class="product-inventory__urgency js-inventory-urgency"></span>
        {% endif %}
        {% if product.metafields.custom.stock_tooltip_text != blank or block.settings.stock_tooltip_text != blank %}
          <span class="stock_tooltip_toggle">
            <svg class="hidden" xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink">
              <symbol id="question" viewBox="0 0 13 13"><path d="M6.473 2.708c-1.083 0-1.76.84-1.815.921a.71.71 0 0 0 .109.948c.298.217.704.19.948-.108 0 0 .325-.406.758-.406.325 0 .704.08.704.541 0 .163-.19.352-.433.596-.434.46-1.03 1.11-1.03 2.194 0 .379.298.677.678.677a.67.67 0 0 0 .677-.677c0-.515.243-.813.65-1.273.379-.406.785-.84.785-1.517.027-.894-.623-1.896-2.031-1.896m.027 8.938A5.144 5.144 0 0 1 1.354 6.5 5.144 5.144 0 0 1 6.5 1.354 5.144 5.144 0 0 1 11.646 6.5 5.144 5.144 0 0 1 6.5 11.646M6.5 0C2.925 0 0 2.925 0 6.5S2.925 13 6.5 13 13 10.075 13 6.5 10.075 0 6.5 0m-.027 8.585a.96.96 0 0 1 .948.948.96.96 0 0 1-.948.948.96.96 0 0 1-.948-.948.96.96 0 0 1 .948-.948"></path></symbol>
            </svg>
            <svg class="question question-toggle" width="16" height="16" viewBox="0 0 16 16" fill="currentColor"><use xlink:href="#question"></use></svg>
            <div class="stock_tooltip_text">
              {% if product.metafields.custom.stock_tooltip_text != blank %}
                {{ product.metafields.custom.stock_tooltip_text | metafield_tag }}
              {% else %}
                {{ block.settings.stock_tooltip_text }}
              {% endif %}  
            </div>
          </span>
        {% endif %}
      </div>
      <div class="backorder_date availability">
         {% if current_variant.inventory_management == "shopify" %}                    
          {% if current_variant.inventory_quantity < 10 and current_variant.inventory_quantity > 0 %}
            <span class="change_content" data-max="{{ current_variant.inventory_quantity }}"></span><div class="extra_info"><div><span id="shipping-time"></span></div></div>
          {% elsif current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue' %}
            {% if current_variant.next_incoming_date %}
                <span class="continue_if_div"><span class="change_content" data-max="{{ current_variant.inventory_quantity }}">Due In Stock {{ current_variant.next_incoming_date | date: "%d/%m/%y"}}</span> <div class="extra_info"> 
                {% if current_variant.inventory_management == "shopify" %}
                {% if current_variant.inventory_quantity < 10 and current_variant.inventory_quantity > 0 %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% elsif current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue' %}
                {% else %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% endif %}  
                {% endif %}
                </div>
              </span>
            {% else %}
              <span class="continue_else_div"><span class="change_content" data-max="{{ current_variant.inventory_quantity }}"></span> <div class="extra_info"> 
                {% if current_variant.inventory_management == "shopify" %}
                {% if current_variant.inventory_quantity < 10 and current_variant.inventory_quantity > 0 %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% elsif current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue' %}
                {% else %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% endif %}  
                {% endif %}
                </div>
              </span>
            {% endif %}                      
          {% elsif current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'deny' %}
            {% if current_variant.next_incoming_date %}
              <span class="deny_if_div"><span class="change_content" data-max="{{ current_variant.inventory_quantity }}">Due In Stock {{ current_variant.next_incoming_date | date: "%d/%m/%y"}}</span> <div class="extra_info"> 
                {% if current_variant.inventory_management == "shopify" %}
                {% if current_variant.inventory_quantity < 10 and current_variant.inventory_quantity > 0 %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% elsif current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue' %}
                {% else %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% endif %}  
                {% endif %}
                </div>
              </span>
            {% else %}
              <span class="deny_else_div"><span class="change_content" data-max="{{ current_variant.inventory_quantity }}"></span> <div class="extra_info"> 
                {% if current_variant.inventory_management == "shopify" %}
                {% if current_variant.inventory_quantity < 10 and current_variant.inventory_quantity > 0 %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% elsif current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue' %}
                {% else %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% endif %}  
                {% endif %}
                </div>
              </span>
            {% endif %}
          {% else %}
            <span class="else_div">
              {% if current_variant.available == false %}
                On Backorder
              {% else %}
              <span><span class="change_content" data-max="{{ current_variant.inventory_quantity }}"></span> <div class="extra_info"> 
                {% if current_variant.inventory_management == "shopify" %}
                {% if current_variant.inventory_quantity < 10 and current_variant.inventory_quantity > 0 %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% elsif current_variant.inventory_quantity <= 0 and current_variant.inventory_policy == 'continue' %}
                {% else %}
                <div {% unless current_variant.available %}class="hidden"{% endunless %}><span id="shipping-time"></span></div> 
                {% endif %}  
                {% endif %}
                </div>
              </span>
              {% endif %}
            </span>
          {% endif %}
        {% else %}
          {% if current_variant.available == false %}
            On Backorder
          {% else %}
          <span>In Stock</span>
          {% endif %}
        {% endif %}
      </div>
    </div>
    {% if block.settings.show_indicator_bar %}
      <div class="product-inventory__indicator js-inventory-indicator" hidden>
        <span style="width: 0%;"></span>
      </div>
    {% endif %}
    <script type="application/json">
      [
        {%- for variant in product.variants -%}
          {"id":{{- variant.id -}},"inventory_management":{{- variant.inventory_management | json -}},"inventory_quantity":{{- variant.inventory_quantity | at_least: 0 -}},"inventory_policy":"{{- variant.inventory_policy -}}","incoming":"{{- variant.incoming -}}","next_incoming_date":"{{- variant.next_incoming_date | date: "%d/%m/%y" -}}","available":{{- variant.available -}}}
          {%- unless forloop.last -%},{%- endunless -%}
        {%- endfor -%}
      ]
    </script>
  {% endif %}
</product-inventory>
