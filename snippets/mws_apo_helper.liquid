} 

.mw-custom-select .selectCustom-trigger {
   border-radius: 30px;
}

.mw-custom-select .selectCustom.isActive .selectCustom-options {
    border-bottom-right-radius: 20px;
    border-bottom-left-radius: 20px;
}

