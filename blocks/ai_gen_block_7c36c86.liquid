{% doc %}
  @prompt
    Create an icons with text block that displays items in a 2x2 grid layout instead of a single horizontal row. The block should maintain the icon and text functionality while arranging the items in a responsive grid format with proper spacing and alignment.

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-icons-grid-{{ ai_gen_id }} {
    padding: {{ block.settings.section_padding }}px 0;
  }

  .ai-icons-grid-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(2, 1fr);
    gap: {{ block.settings.grid_gap }}px;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-icons-grid-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: center;
    text-align: center;
    padding: {{ block.settings.item_padding }}px;
    background-color: {{ block.settings.item_background_color }};
    border-radius: {{ block.settings.item_border_radius }}px;
    border: {{ block.settings.item_border_width }}px solid {{ block.settings.item_border_color }};transition: transform 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-icons-grid-item-{{ ai_gen_id }}:hover {
    transform: translateY(-{{ block.settings.hover_lift }}px);
    box-shadow: 0 {{ block.settings.hover_shadow }}px {{ block.settings.hover_shadow | times: 2 }}px rgba(0, 0, 0, 0.1);
  }

  .ai-icons-grid-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.icon_background_color }};
    border-radius: {{ block.settings.icon_border_radius }}px;
  }

  .ai-icons-grid-icon-wrapper-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-icons-grid-icon-wrapper-{{ ai_gen_id }} svg {
    width: {{ block.settings.icon_size | times: 0.7 }}px;
    height: {{ block.settings.icon_size | times: 0.7 }}px;color: {{ block.settings.icon_color }};
  }

  .ai-icons-grid-title-{{ ai_gen_id }} {
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: {{ block.settings.title_font_weight }};
    color: {{ block.settings.title_color }};
    margin: 0 0 {{ block.settings.title_spacing }}px 0;
    line-height: 1.3;
  }

  .ai-icons-grid-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_font_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.5;
  }

  .ai-icons-grid-placeholder-{{ ai_gen_id }} {
    background-color: #f4f4f4;
    border: 2px dashed #ccc;
    border-radius: {{ block.settings.item_border_radius }}px;
    padding: {{ block.settings.item_padding }}px;
    text-align: center;
    color: #666;
    font-style: italic;
  }

  @media screen and (max-width: 749px) {
    .ai-icons-grid-container-{{ ai_gen_id }} {
      grid-template-columns: repeat({{ block.settings.columns_mobile }}, 1fr);gap: {{ block.settings.grid_gap | times: 0.75 }}px;
    }

    .ai-icons-grid-icon-wrapper-{{ ai_gen_id }} {
      width: {{ block.settings.icon_size | times: 0.8 }}px;
      height: {{ block.settings.icon_size | times: 0.8 }}px;
    }

    .ai-icons-grid-icon-wrapper-{{ ai_gen_id }} svg {
      width: {{ block.settings.icon_size | times: 0.56 }}px;
      height: {{ block.settings.icon_size | times: 0.56 }}px;
    }

    .ai-icons-grid-title-{{ ai_gen_id }} {
      font-size: {{ block.settings.title_font_size | times: 0.9 }}px;
    }

    .ai-icons-grid-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="ai-icons-grid-{{ ai_gen_id }}" {{ block.shopify_attributes }}><div class="ai-icons-grid-container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign icon_key = 'icon_' | append: i
        assign title_key = 'title_' | append: i
        assign description_key = 'description_' | append: i

        assign icon = block.settings[icon_key]
        assign title = block.settings[title_key]
        assign description = block.settings[description_key]
      %}

      {% if icon != blank or title != blank or description != blank %}
        <div class="ai-icons-grid-item-{{ ai_gen_id }}">
          <div class="ai-icons-grid-icon-wrapper-{{ ai_gen_id }}">
            {% if icon != blank %}
              <img
                src="{{ icon | image_url: width: 200 }}"
                alt="{{ title | escape }}"
                loading="lazy"
                width="200"
                height="200"
              >
            {% else %}
              <svg
                xmlns="http://www.w3.org/2000/svg"
                width="24"
                height="24"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <circle cx="12" cy="12" r="10"></circle>
                <line x1="12" y1="8" x2="12" y2="12"></line>
                <line x1="12" y1="16" x2="12.01" y2="16"></line>
              </svg>
            {% endif %}
          </div>

          {% if title != blank %}
            <h3 class="ai-icons-grid-title-{{ ai_gen_id }}">{{ title }}</h3>
          {% endif %}

          {% if description != blank %}
            <p class="ai-icons-grid-description-{{ ai_gen_id }}">{{ description }}</p>
          {% endif %}
        </div>
      {% else %}
        <div class="ai-icons-grid-placeholder-{{ ai_gen_id }}">
          <p>Add content for item {{ i }}</p>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</div>

