{% doc %}
  @prompt
    A magazine-style editorial layout

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .editorial-layout-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px;
    background-color: {{ block.settings.background_color }};
  }

  .editorial-container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: 1fr;
    gap: {{ block.settings.content_spacing }}px;
  }

  @media screen and (min-width: 750px) {
    .editorial-container-{{ ai_gen_id }} {
      grid-template-columns: {% if block.settings.layout == 'image_left' %}1fr 1fr{% elsif block.settings.layout == 'image_right' %}1fr 1fr{% else %}1fr{% endif %};
    }
  }

  .editorial-image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    position: relative;
    overflow: hidden;
    {% if block.settings.layout == 'image_top' or block.settings.layout == 'image_bottom' %}
      grid-column: 1 / -1;
    {% endif %}
    {% if block.settings.layout == 'image_bottom' %}
      order: 2;
    {% endif %}
  }

  .editorial-image-{{ ai_gen_id }} {
    width: 100%;
    height: auto;
    display: block;
    object-fit: cover;
  }

  .editorial-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: {{ block.settings.image_aspect_ratio }};
    background-color: #f4f4f4;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .editorial-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    max-width: 500px;
    max-height: 500px;
  }

  .editorial-content-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    justify-content: {{ block.settings.content_vertical_alignment }};
    padding: {{ block.settings.content_padding }}px;
    {% if block.settings.layout == 'image_right' %}
      order: -1;
    {% endif %}
  }

  .editorial-eyebrow-{{ ai_gen_id }} {
    font-size: {{ block.settings.eyebrow_font_size }}px;
    text-transform: {{ block.settings.eyebrow_text_transform }};
    letter-spacing: {{ block.settings.eyebrow_letter_spacing }}px;
    color: {{ block.settings.eyebrow_color }};
    margin-bottom: 0.5em;
    font-family: {{ block.settings.heading_font | font_modify: 'weight', 'normal' | font_face }};
  }

  .editorial-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_font_size }}px;
    line-height: 1.2;
    margin-bottom: 0.5em;
    color: {{ block.settings.heading_color }};
    font-family: {{ block.settings.heading_font | font_face }};
    font-weight: {{ block.settings.heading_weight }};
  }

  .editorial-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_font_size }}px;
    line-height: 1.4;
    margin-bottom: 1em;
    color: {{ block.settings.subheading_color }};
    font-family: {{ block.settings.body_font | font_face }};
    font-style: italic;
  }

  .editorial-body-{{ ai_gen_id }} {
    font-size: {{ block.settings.body_font_size }}px;
    line-height: {{ block.settings.body_line_height }};
    color: {{ block.settings.body_color }};
    font-family: {{ block.settings.body_font | font_face }};}

  .editorial-body-{{ ai_gen_id }} p {
    margin-bottom: 1em;
  }

  .editorial-body-{{ ai_gen_id }} p:last-child {
    margin-bottom: 0;
  }

  .editorial-dropcap-{{ ai_gen_id }} .editorial-body-{{ ai_gen_id }} p:first-child::first-letter {
    float: left;
    font-size: 3em;
    line-height: 0.8;
    padding-right: 0.1em;
    font-family: {{ block.settings.heading_font | font_face }};
    color: {{ block.settings.heading_color }};
  }

  .editorial-divider-{{ ai_gen_id }} {
    width: 20%;
    height: 1px;
    background-color: {{ block.settings.divider_color }};
    margin: 1em 0;
  }

  @media screen and (max-width: 749px) {
    .editorial-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_font_size | times: 0.7 }}px;
    }
    
    .editorial-eyebrow-{{ ai_gen_id }} {
      font-size: {{ block.settings.eyebrow_font_size | times: 0.8 }}px;
    }
    
    .editorial-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_font_size | times: 0.8 }}px;
    }
    
    .editorial-body-{{ ai_gen_id }} {
      font-size: {{ block.settings.body_font_size | times: 0.9 }}px;
    }
  }
{% endstyle %}

<div class="editorial-layout-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="editorial-container-{{ ai_gen_id }}">
    <div class="editorial-image-wrapper-{{ ai_gen_id }}">
      {% if block.settings.image %}
        <img 
          src="{{ block.settings.image | image_url: width: 2000 }}"
          alt="{{ block.settings.image.alt | escape }}"
          class="editorial-image-{{ ai_gen_id }}"
          width="{{ block.settings.image.width }}"
          height="{{ block.settings.image.height }}"
          loading="lazy"
        >
      {% else %}
        <div class="editorial-image-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>
    
    <div class="editorial-content-{{ ai_gen_id }}">
      {% if block.settings.eyebrow != blank %}
        <div class="editorial-eyebrow-{{ ai_gen_id }}">{{ block.settings.eyebrow }}</div>
      {% endif %}
      
      {% if block.settings.heading != blank %}
        <h2 class="editorial-heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      {% endif %}
      
      {% if block.settings.show_divider %}
        <div class="editorial-divider-{{ ai_gen_id }}"></div>
      {% endif %}
      
      {% if block.settings.subheading != blank %}
        <div class="editorial-subheading-{{ ai_gen_id }}">{{ block.settings.subheading }}</div>
      {% endif %}<div class="editorial-body-{{ ai_gen_id }} {% if block.settings.enable_dropcap %}editorial-dropcap-{{ ai_gen_id }}{% endif %}">
        {{ block.settings.body_text }}
      </div>
    </div>
  </div>
</div>

{% schema %}
{
  "name": "Magazine Editorial",
  "settings": [
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "select",
      "id": "layout",
      "label": "Layout",
      "options": [
        {
          "value": "image_left",
          "label": "Image left"
        },
        {
          "value": "image_right",
          "label": "Image right"
        },
        {
          "value": "image_top",
          "label": "Image top"
        },
        {
          "value": "image_bottom",
          "label": "Image bottom"
        }
      ],
      "default": "image_left"
    },
    {
      "type": "range",
      "id": "section_padding",
      "min": 0,
      "max": 100,
      "step": 10,
      "unit": "px",
      "label": "Section padding",
      "default": 40
    },
    {
      "type": "range",
      "id": "content_padding",
      "min": 0,
      "max": 60,
      "step": 10,
      "unit": "px",
      "label": "Content padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "content_spacing",
      "min": 0,
      "max": 60,
      "step": 10,
      "unit": "px",
      "label": "Space between content and image",
      "default": 30
    },
    {
      "type": "select",
      "id": "content_vertical_alignment",
      "label": "Content vertical alignment",
      "options": [
        {
          "value": "flex-start",
          "label": "Top"
        },
        {
          "value": "center",
          "label": "Middle"
        },
        {
          "value": "flex-end",
          "label": "Bottom"
        }
      ],
      "default": "center"
    },
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "eyebrow",
      "label": "Eyebrow text",
      "default": "FEATURE STORY"
    },
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Your Magazine-Style Headline Goes Here"
    },
    {
      "type": "text",
      "id": "subheading",
      "label": "Subheading",
      "default": "A compelling subheading that draws readers into your story"
    },
    {
      "type": "richtext",
      "id": "body_text",
      "label": "Body text",
      "default": "<p>Start with an engaging opening paragraph that hooks your reader. Magazine-style layouts often begin with a compelling anecdote or statement that draws the reader in and establishes the tone of the piece.</p><p>Follow with supporting paragraphs that develop your narrative or argument. Use clear, concise language and vary your sentence structure to maintain reader interest. Consider including quotes or statistics to add credibility and depth to your content.</p><p>Conclude with a thought-provoking statement or call to action that leaves a lasting impression on your reader and encourages further engagement with your brand or products.</p>"
    },
    {
      "type": "checkbox",
      "id": "enable_dropcap",
      "label": "Enable drop cap",
      "default": true
    },
    {
      "type": "checkbox",
      "id": "show_divider",
      "label": "Show divider",
      "default": true
    },
    {
      "type": "header",
      "content": "Image"
    },
    {
      "type": "image_picker",
      "id": "image",
      "label": "Image"
    },
    {
      "type": "select",
      "id": "image_aspect_ratio",
      "label": "Image aspect ratio",
      "options": [
        {
          "value": "1/1",
          "label": "1:1 (Square)"
        },
        {
          "value": "16/9",
          "label": "16:9 (Landscape)"
        },
        {
          "value": "4/3",
          "label": "4:3 (Standard)"
        },
        {
          "value": "3/4",
          "label": "3:4 (Portrait)"
        },
        {
          "value": "2/3",
          "label": "2:3 (Portrait)"
        }
      ],
      "default": "4/3"
    },
    {
      "type": "header",
      "content": "Typography"
    },
    {
      "type": "font_picker",
      "id": "heading_font",
      "label": "Heading font",
      "default": "helvetica_n7"
    },
    {
      "type": "select",
      "id": "heading_weight",
      "label": "Heading weight",
      "options": [
        {
          "value": "normal",
          "label": "Normal"
        },
        {
          "value": "bold",
          "label": "Bold"
        }
      ],
      "default": "bold"
    },
    {
      "type": "font_picker",
      "id": "body_font",
      "label": "Body font",
      "default": "helvetica_n4"
    },
    {
      "type": "range",
      "id": "eyebrow_font_size",
      "min": 10,
      "max": 20,
      "step": 1,
      "unit": "px",
      "label": "Eyebrow font size",
      "default": 14
    },
    {
      "type": "select",
      "id": "eyebrow_text_transform",
      "label": "Eyebrow text transform",
      "options": [
        {
          "value": "none",
          "label": "None"
        },
        {
          "value": "uppercase",
          "label": "Uppercase"
        }
      ],
      "default": "uppercase"
    },
    {
      "type": "range",
      "id": "eyebrow_letter_spacing",
      "min": 0,
      "max": 5,
      "step": 0.5,
      "unit": "px",
      "label": "Eyebrow letter spacing",
      "default": 1.5
    },
    {
      "type": "range",
      "id": "heading_font_size",
      "min": 20,
      "max": 72,
      "step": 2,
      "unit": "px",
      "label": "Heading font size",
      "default": 42
    },
    {
      "type": "range",
      "id": "subheading_font_size",
      "min": 14,
      "max": 32,
      "step": 1,
      "unit": "px",
      "label": "Subheading font size",
      "default": 18
    },
    {
      "type": "range",
      "id": "body_font_size",
      "min": 12,
      "max": 24,
      "step": 1,
      "unit": "px",
      "label": "Body font size",
      "default": 16
    },
    {
      "type": "range",
      "id": "body_line_height",
      "min": 1.2,
      "max": 2,
      "step": 0.1,
      "label": "Body line height",
      "default": 1.6
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "eyebrow_color",
      "label": "Eyebrow color",
      "default": "#777777"
    },
    {
      "type": "color",
      "id": "heading_color",
      "label": "Heading color",
      "default": "#000000"
    },
    {
      "type": "color",
      "id": "subheading_color",
      "label": "Subheading color",
      "default": "#555555"
    },
    {
      "type": "color",
      "id": "body_color",
      "label": "Body text color",
      "default": "#333333"
    },
    {
      "type": "color",
      "id": "divider_color",
      "label": "Divider color",
      "default": "#000000"
    }
  ],
  "presets": [
    {
      "name": "Magazine Editorial"
    }
  ],
  "tag": null
}
{% endschema %}