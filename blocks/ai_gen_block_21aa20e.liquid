{% doc %}
  @prompt
    An interactive vertical timeline that highlights as the user scrolls

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-timeline-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.section_padding }}px 20px;
  }

  .ai-timeline-{{ ai_gen_id }} {
    position: relative;
    padding-left: 60px;
  }

  .ai-timeline-line-{{ ai_gen_id }} {
    position: absolute;
    left: 20px;
    top: 0;
    bottom: 0;
    width: 4px;
    background-color: {{ block.settings.line_inactive_color }};
    border-radius: 2px;
  }

  .ai-timeline-progress-{{ ai_gen_id }} {
    position: absolute;
    left: 20px;
    top: 0;
    width: 4px;
    height: 0%;
    background-color: {{ block.settings.line_active_color }};
    border-radius: 2px;
    transition: height 0.3s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }} {
    position: relative;
    margin-bottom: {{ block.settings.item_spacing }}px;
    opacity: 0.5;
    transition: opacity 0.3s ease, transform 0.3s ease;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: translateX(10px);
  }

  .ai-timeline-dot-{{ ai_gen_id }} {
    position: absolute;
    left: -52px;
    top: 8px;
    width: {{ block.settings.dot_size }}px;
    height: {{ block.settings.dot_size }}px;
    background-color: {{ block.settings.dot_inactive_color }};
    border: 3px solid {{ block.settings.dot_border_color }};
    border-radius: 50%;
    transition: all 0.3s ease;
    z-index: 2;
  }

  .ai-timeline-item-{{ ai_gen_id }}.active .ai-timeline-dot-{{ ai_gen_id }} {
    background-color: {{ block.settings.dot_active_color }};
    transform: scale(1.2);
    box-shadow: 0 0 0 8px {{ block.settings.dot_active_color }}20;
  }

  .ai-timeline-content-{{ ai_gen_id }} {
    background-color: {{ block.settings.card_bg_color }};
    padding: {{ block.settings.card_padding }}px;
    border-radius: {{ block.settings.card_border_radius }}px;
    border: 1px solid {{ block.settings.card_border_color }};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-timeline-date-{{ ai_gen_id }} {
    color: {{ block.settings.date_color }};
    font-size: {{ block.settings.date_font_size }}px;
    font-weight: 600;
    margin-bottom: 8px;
  }

  .ai-timeline-title-{{ ai_gen_id }} {
    color: {{ block.settings.title_color }};
    font-size: {{ block.settings.title_font_size }}px;
    font-weight: 700;
    margin: 0 0 12px 0;
  }

  .ai-timeline-description-{{ ai_gen_id }} {
    color: {{ block.settings.text_color }};
    font-size: {{ block.settings.text_font_size }}px;
    line-height: 1.6;
    margin: 0;
  }

  .ai-timeline-image-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 16px;
  }

  .ai-timeline-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    max-width: {{ block.settings.image_max_width }}px;
    height: 200px;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-timeline-image-placeholder-{{ ai_gen_id }} svg {
    width: 60px;
    height: 60px;
    opacity: 0.3;
  }

  @media screen and (max-width: 768px) {
    .ai-timeline-{{ ai_gen_id }} {
      padding-left: 40px;
    }

    .ai-timeline-dot-{{ ai_gen_id }} {
      left: -32px;
    }

    .ai-timeline-content-{{ ai_gen_id }} {
      padding: {{ block.settings.card_padding | times: 0.75 }}px;
    }

    .ai-timeline-item-{{ ai_gen_id }}.active {
      transform: translateX(5px);
    }
  }
{% endstyle %}

<scroll-timeline-{{ ai_gen_id }}
  class="ai-timeline-container-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  <div class="ai-timeline-{{ ai_gen_id }}">
    <div class="ai-timeline-line-{{ ai_gen_id }}"></div>
    <div class="ai-timeline-progress-{{ ai_gen_id }}"></div>

    {% for i in (1..block.settings.timeline_items) %}
      {% liquid
        assign item_date_key = 'item_' | append: i | append: '_date'
        assign item_title_key = 'item_' | append: i | append: '_title'
        assign item_description_key = 'item_' | append: i | append: '_description'
        assign item_image_key = 'item_' | append: i | append: '_image'

        assign item_date = block.settings[item_date_key]
        assign item_title = block.settings[item_title_key]
        assign item_description = block.settings[item_description_key]
        assign item_image = block.settings[item_image_key]
      %}

      {% if item_title != blank or item_description != blank %}
        <div class="ai-timeline-item-{{ ai_gen_id }}" data-timeline-item="{{ i }}">
          <div class="ai-timeline-dot-{{ ai_gen_id }}"></div>
          <div class="ai-timeline-content-{{ ai_gen_id }}">
            {% if item_image %}
              <img
                src="{{ item_image | image_url: width: 800 }}"
                alt="{{ item_image.alt | escape }}"
                class="ai-timeline-image-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ item_image.width }}"
                height="{{ item_image.height }}"
              >
            {% elsif block.settings.show_placeholder_images %}
              <div class="ai-timeline-image-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}

            {% if item_date != blank %}
              <div class="ai-timeline-date-{{ ai_gen_id }}">{{ item_date }}</div>
            {% endif %}

            {% if item_title != blank %}
              <h3 class="ai-timeline-title-{{ ai_gen_id }}">{{ item_title }}</h3>
            {% endif %}

            {% if item_description != blank %}
              <div class="ai-timeline-description-{{ ai_gen_id }}">{{ item_description }}</div>
            {% endif %}
          </div>
        </div>
      {% endif %}
    {% endfor %}
  </div>
</scroll-timeline-{{ ai_gen_id }}>

<script>
  (function() {
    class ScrollTimeline{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.timelineItems = [];
        this.progressLine = null;
        this.timelineContainer = null;
      }

      connectedCallback() {
        this.timelineItems = this.querySelectorAll('.ai-timeline-item-{{ ai_gen_id }}');
        this.progressLine = this.querySelector('.ai-timeline-progress-{{ ai_gen_id }}');
        this.timelineContainer = this.querySelector('.ai-timeline-{{ ai_gen_id }}');
        
        this.setupScrollListener();
        this.updateTimeline();
      }

      setupScrollListener() {
        let ticking = false;
        
        const scrollHandler = () => {
          if (!ticking) {
            requestAnimationFrame(() => {
              this.updateTimeline();
              ticking = false;
            });
            ticking = true;
          }
        };

        window.addEventListener('scroll', scrollHandler);
        window.addEventListener('resize', scrollHandler);
      }

      updateTimeline() {
        if (!this.timelineItems.length || !this.progressLine || !this.timelineContainer) return;

        const containerRect = this.timelineContainer.getBoundingClientRect();
        const containerTop = containerRect.top + window.pageYOffset;
        const containerHeight = containerRect.height;
        const viewportHeight = window.innerHeight;
        const scrollTop = window.pageYOffset;
        
        const viewportCenter = scrollTop + viewportHeight / 2;
        const timelineStart = containerTop;
        const timelineEnd = containerTop + containerHeight;

        let activeItemIndex = -1;
        let progressPercentage = 0;

        this.timelineItems.forEach((item, index) => {
          const itemRect = item.getBoundingClientRect();
          const itemTop = itemRect.top + scrollTop;
          const itemCenter = itemTop + itemRect.height / 2;

          const isActive = viewportCenter >= itemCenter - viewportHeight * 0.3;
          
          if (isActive) {
            item.classList.add('active');
            activeItemIndex = index;
          } else {
            item.classList.remove('active');
          }
        });

        if (activeItemIndex >= 0 && this.timelineItems[activeItemIndex]) {
          const activeItem = this.timelineItems[activeItemIndex];
          const activeItemRect = activeItem.getBoundingClientRect();
          const activeItemTop = activeItemRect.top + scrollTop;
          const activeItemBottom = activeItemTop + activeItemRect.height;
          
          const relativeProgress = Math.min(
            (viewportCenter - timelineStart) / (activeItemBottom - timelineStart),
            1
          );
          
          progressPercentage = Math.max(0, Math.min(100, relativeProgress * 100));
        } else if (viewportCenter < timelineStart) {
          progressPercentage = 0;
        } else if (viewportCenter > timelineEnd) {
          progressPercentage = 100;
        }

        this.progressLine.style.height = `${progressPercentage}%`;
      }
    }

    customElements.define('scroll-timeline-{{ ai_gen_id }}', ScrollTimeline{{ ai_gen_id }});
  })();
</script>

