{% doc %}
  @prompt
    A heading with an animated glowing effect

{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-glowing-heading-{{ ai_gen_id }} {
    text-align: {{ block.settings.text_alignment }};
    margin:0;
    padding: {{ block.settings.padding }}px 0;
    font-size: {{ block.settings.font_size }}px;
    font-weight: {{ block.settings.font_weight }};
    color: {{ block.settings.text_color }};
    text-shadow: 
      0 0 5px {{ block.settings.glow_color }},
      0 0 10px {{ block.settings.glow_color }},
      0 0 15px {{ block.settings.glow_color }},
      0 0 20px {{ block.settings.glow_color }};
    animation: ai-glow-pulse-{{ ai_gen_id }} {{ block.settings.animation_speed }}s ease-in-out infinite alternate;
  }

  @keyframes ai-glow-pulse-{{ ai_gen_id }} {
    from {
      text-shadow: 
        0 0 5px {{ block.settings.glow_color }},
        0 0 10px {{ block.settings.glow_color }},
        0 0 15px {{ block.settings.glow_color }},
        0 0 20px {{ block.settings.glow_color }};
    }
    to {
      text-shadow: 
        0 0 10px {{ block.settings.glow_color }},
        0 0 20px {{ block.settings.glow_color }},
        0 0 30px {{ block.settings.glow_color }},
        0 0 40px {{ block.settings.glow_color }};
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .ai-glowing-heading-{{ ai_gen_id }} {
      animation: none;
      text-shadow: 
        0 0 5px {{ block.settings.glow_color }},
        0 0 10px {{ block.settings.glow_color }},
        0 0 15px {{ block.settings.glow_color }},
        0 0 20px {{ block.settings.glow_color }};
    }
  }
{% endstyle %}

<h2 
  class="ai-glowing-heading-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
  {{ block.settings.heading_text }}
</h2>

{% schema %}
{
  "name": "Glowing Heading",
  "settings": [
    {
      "type": "header",
      "content": "Content"
    },
    {
      "type": "text",
      "id": "heading_text",
      "label": "Heading text",
      "default": "Glowing Heading"
    },
    {
      "type": "header",
      "content": "Style"
    },
    {
      "type": "select",
      "id": "text_alignment",
      "label": "Text alignment",
      "options": [
        {
          "value": "left",
          "label": "Left"
        },
        {
          "value": "center",
          "label": "Center"
        },
        {
          "value": "right",
          "label": "Right"
        }
      ],
      "default": "center"
    },
    {
      "type": "range",
      "id": "font_size",
      "min": 16,
      "max": 80,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 48
    },
    {
      "type": "select",
      "id": "font_weight",
      "label": "Font weight",
      "options": [
        {
          "value": "400",
          "label": "Normal"
        },
        {
          "value": "600",
          "label": "Semi-bold"
        },
        {
          "value": "700",
          "label": "Bold"
        },
        {
          "value": "800",
          "label": "Extra bold"
        }
      ],
      "default": "700"
    },
    {
      "type": "range",
      "id": "padding",
      "min": 0,
      "max": 80,
      "step": 4,
      "unit": "px",
      "label": "Vertical padding",
      "default": 32
    },
    {
      "type": "header",
      "content": "Colors"
    },
    {
      "type": "color",
      "id": "text_color",
      "label": "Text color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "glow_color",
      "label": "Glow color",
      "default": "#00ffff"
    },
    {
      "type": "header",
      "content": "Animation"
    },
    {
      "type": "range",
      "id": "animation_speed",
      "min": 1,
      "max": 5,
      "step": 0.5,
      "unit": "s",
      "label": "Animation speed",
      "default": 2
    }
  ],
  "presets": [
    {
      "name": "Glowing Heading"
    }
  ],
  "tag": null
}
{% endschema %}