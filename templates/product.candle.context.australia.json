    "faq_DEeyA": {
      "type": "faq",
      "disabled": false,
      "settings": {
        "header-3189a023081c8516b611d42376f59915": null,
        "heading": "LED Candle Bulbs: Frequently Asked Questions",
        "heading_align": "text-center",
        "header-1aaa00937b9763e30c33b48396283a25": null,
        "color_scheme": "none",
        "full_width": true
      },
      "blocks": {
        "question_mgV8R": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "Which base size do I need, and is E12 suitable for US fittings?",
            "text": "<p>We stock a full range of bases (E14, E27, B15, B22), including the <strong>E12 Candelabra base</strong>. The E12 is the standard size for light fittings imported from the US; if you have a North American chandelier or lamp, this is the correct bulb for your fixture.</p>"
          }
        },
        "question_Bew6r": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "What is the difference between Clear, Frosted, and Porcelain glass finishes?",
            "text": "<p><strong>Clear glass</strong> is designed for crystal chandeliers to create a brilliant sparkle; <strong>Frosted glass</strong> diffuses light to reduce harsh glares; and <strong>Porcelain (Opal)</strong> offers an entirely uniform, matte white glow. Choose Porcelain or Frosted for a softer, more contemporary aesthetic that is easy on the eyes.</p>"
          }
        },
        "question_c36CT": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "How do I choose the right colour temperature (2200K to 4000K)?",
            "text": "<p>Select <strong>2200K (Sunset Glow)</strong> for an ultra-warm, vintage feel; <strong>2700K (Warm White)</strong> for traditional living areas; <strong>3000K (Soft White)</strong> for a slightly cleaner look; or <strong>4000K (Cool White)</strong> for task-heavy spaces like kitchens or work areas.</p>"
          }
        },
        "question_qFTqh": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "Are these LED candle bulbs compatible with my dimmer switch?",
            "text": "<p>Our candle bulbs are fully dimmable and optimised for modern trailing-edge LED dimmers. To ensure flicker-free performance and a long lifespan, we recommend avoiding older \"leading-edge\" magnetic dimmers, which may not be compatible with low-wattage LED technology.</p>"
          }
        },
        "question_39tmr": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "Do these bulbs produce \"True Colour\" light?",
            "text": "<p>Yes, all our LED candles feature a high Colour Rendering Index (CRI), providing \"True Colour\" light. This ensures that your interior colours, furniture, and fabrics appear rich and accurate, rather than looking dull or greyish as they often do with lower-quality bulbs.</p>"
          }
        }
      },
