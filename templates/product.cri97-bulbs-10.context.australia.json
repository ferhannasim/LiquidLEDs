    "faq_By4a3": {
      "type": "faq",
      "disabled": false,
      "settings": {
        "header-f3b43695194129a61395270317814bb5": null,
        "heading": "CRI 95+ LED Bulbs: High Colour Accuracy FAQs",
        "heading_align": "text-center",
        "header-0e3be6999f070ab7b4ce2677b6200419": null,
        "color_scheme": "none",
        "full_width": true
      },
      "blocks": {
        "question_Tqhbtj": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "Why should I choose CRI 95+ LED bulbs over standard CRI 80?",
            "text": "<p>Standard bulbs often make interiors look grey or \"muddy\" because they lack depth in the colour spectrum. Our CRI 95+ collection provides \"True Colour\" light that is almost indistinguishable from natural daylight, making your furniture, artwork, and skin tones look vibrant and accurate.</p>"
          }
        },
        "question_KimWVa": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "Do these high CRI bulbs have a high R9 value for reds?",
            "text": "<p>Yes, our CRI 95+ range is specifically engineered with high R9 values, which is the specific metric for rendering deep reds. This is essential for bringing out the rich grain in timber flooring and ensuring skin tones look healthy rather than washed out under artificial light.</p>"
          }
        },
        "question_AGj89a": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "Are these high-quality LED bulbs flicker-free?",
            "text": "<p>Absolutely. We use advanced constant-current drivers within our bulbs to ensure a flicker-free performance that is gentle on the eyes. This reduces the risk of eye strain and headaches, which are common issues with cheaper, low-quality LED alternatives.</p>"
          }
        },
        "question_VxhhrK": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "Will these CRI 95+ bulbs work with my existing dimmer switches?",
            "text": "<p>These bulbs are fully dimmable and designed to be compatible with most modern trailing-edge LED dimmers. To ensure the smoothest dimming range without buzzing, we always recommend checking that your dimmer switch is rated for low-wattage LED loads.</p>"
          }
        },
        "question_8CHGJt": {
          "type": "question",
          "disabled": false,
          "settings": {
            "icon": "none",
            "heading": "Can I use these bulbs in art galleries or high-end retail displays?",
            "text": "<p>Yes, our CRI 95+ collection is the preferred choice for galleries and boutique retail where colour precision is non-negotiable. The high fidelity ensures that products and paintings are viewed exactly as the artist or designer intended, with no artificial colour shifting.</p>"
          }
        }
      },
